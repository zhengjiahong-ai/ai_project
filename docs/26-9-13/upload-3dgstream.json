eadingNumber":"4","level":1,"nestedLevel":1,"parentId":null,"pageIndex":3,"page":4,"bbox":{"x":308.86,"y":156.6,"width":51.8,"height":10.75},"anchorY":156.6,"source":"tei","sourceDetails":["tei-head"],"confidence":0.95,"preview":"3DGStream constructs photo-realistic FVV streams from multi-view video streams on-the-fly using a per-frame training paradigm. We initiate the process by training 3DGs [26] at time","type":"section","order":11},{"id":"outline-4-2-12","title":"4.2 Adaptive 3DG Addition","displayTitle":"4.2 Adaptive 3DG Addition","rawTitle":"Adaptive 3DG Addition","headingNumber":"4.2","level":2,"nestedLevel":2,"parentId":"outline-4-11","pageIndex":4,"page":5,"bbox":{"x":308.86,"y":144.84,"width":130.39,"height":9.85},"anchorY":144.84,"source":"tei","sourceDetails":["tei-head"],"confidence":0.95,"preview":"Relying solely on 3DGs transformations adequately cover a significant portion of real-world dynamic scenes, with translations effectively managing occlusions and disappearances in ","type":"section","order":12},{"id":"outline-29-13","title":"29 Section 29","displayTitle":"29 Section 29","rawTitle":"Section 29","headingNumber":"29","level":1,"nestedLevel":1,"parentId":null,"pageIndex":5,"page":6,"bbox":{"x":181.2,"y":339.42,"width":217.1,"height":11.96},"anchorY":338.422,"source":"inferred","sourceDetails":["inferred-missing-parent"],"confidence":0.35,"preview":"由子章节编号自动补齐的父级章节，请以原文为准。","type":"section","order":13},{"id":"outline-29-58-14","title":"29.58 0.1 260 0.02 27.15 1015 14 10 I-NGP [40] ×","displayTitle":"29.58 0.1 260 0.02 27.15 1015 14 10 I-NGP [40] ×","rawTitle":"0.1 260 0.02 27.15 1015 14 10 I-NGP [40] ×","headingNumber":"29.58","level":2,"nestedLevel":2,"parentId":"outline-29-13","pageIndex":5,"page":6,"bbox":{"x":181.2,"y":339.42,"width":217.1,"height":11.96},"anchorY":339.422,"source":"pdf-layout","sourceDetails":["pdf-line-heading","split-number-title"],"confidence":0.9,"preview":"","type":"section","order":14},{"id":"outline-0-1-15","title":