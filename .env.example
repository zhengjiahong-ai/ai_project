# Pixiu Academic Assistant — Environment Variables
#
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── LLM Provider (DeepSeek) ──────────────────────────────────────────────────
# Required. Get your key from https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TRANSLATION_MODEL=deepseek-v4-flash
DEEPSEEK_THINKING_TYPE=enabled
DEEPSEEK_REASONING_EFFORT=high

# ── Neo4j (optional, graph persistence) ─────────────────────────────────────
# Uncomment if using the neo4j profile in docker-compose.
# NEO4J_URI=bolt://neo4j:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=pixiu_neo4j_password
# NEO4J_AUTH=neo4j/pixiu_neo4j_password

# ── Data Paths ───────────────────────────────────────────────────────────────
# RESEARCH_TASK_DB_PATH=ai-service-python/data/research_tasks.sqlite3
# KNOWLEDGE_GRAPH_DB_PATH=ai-service-python/data/knowledge_graph.sqlite3

# ── Feature Gates ────────────────────────────────────────────────────────────
# PIXIU_MCP_ENABLED=false
# PIXIU_ALLOW_BROWSER=false
# PIXIU_ALLOW_REPRODUCIBILITY=false

# ── Runtime ──────────────────────────────────────────────────────────────────
# PIXIU_TASK_POOL_SIZE=2
# PIXIU_MAX_TOKENS_PER_TASK=500000
# PIXIU_AGENTIC_MAX_ITERATIONS=3

# ── Embedding model / HuggingFace ────────────────────────────────────────────
# 控制容器内的 HF_HUB_OFFLINE，默认 1（只用 huggingface_cache 卷里的缓存）。
# 设为 0 才会联网下载：HF 不可达时联网会让 warmup 卡 6~10 分钟才监听端口。
# 换嵌入模型（core/rag_vector_db.py 的 EMBEDDING_MODEL_CANDIDATES）时先设 0 拉一次，
# 下载完成后改回 1。改完需要 docker compose up -d --no-build ai-service 重建容器生效。
# PIXIU_HF_OFFLINE=1

# ── Retrieval query rewrite ────────────────────────────────────
# 控制容器内的 PIXIU_QUERY_REWRITE_ENABLED，默认 1（开启）。
# 中文提问检索英文论文时，查询会先经翻译 LLM 译成英文再检索：多语言小模型在纯英文
# 语料上处理中文查询会系统性坍缩到同一篇论文（实测 10 个中文查询有 7 个 top-1 落在
# 同一篇仅占库 15% chunk 的论文上），译成英文后 4/4 修正为正确 top-1。
# 设为 0 退回改写前行为（每次检索省掉一次翻译调用）；语料本身是中文时改写会自动跳过。
# 改完需要 docker compose up -d --no-build ai-service 重建容器生效。
# A/B 对比方法见 ai-service-python/benchmarks/retrieval_quality/README.md。
# PIXIU_QUERY_REWRITE_ENABLED=1

# ── Timeouts (seconds) ───────────────────────────────────────────────────────
# PIXIU_RETRIEVAL_TIMEOUT_SECONDS=15
# PIXIU_EXTERNAL_SEARCH_TIMEOUT_SECONDS=20
# PIXIU_WEB_FETCH_TIMEOUT_SECONDS=30
# PIXIU_SLOW_QUERY_THRESHOLD_MS=3000

# ── External Search (disabled by default) ────────────────────────────────────
# PIXIU_EXTERNAL_SEARCH_ENABLED=false
# PIXIU_EXTERNAL_SEARCH_PROVIDERS=crossref,arxiv
# CROSSREF_API_KEY=
# SEMANTIC_SCHOLAR_API_KEY=
